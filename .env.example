# Environment Variables for Multi-Agent Consensus System
# Copy this file to .env and fill in your API keys

# ============================================
# AI Coding CLI API Keys
# ============================================

# Claude Code (Anthropic)
# Get your key at: https://console.anthropic.com/
# Or authenticate via: claude auth login
ANTHROPIC_API_KEY=

# OpenAI Codex
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini
# Get your key at: https://aistudio.google.com/apikey
# Or authenticate via: gemini auth login
GEMINI_API_KEY=

# Cursor (optional - can use session auth instead)
# CURSOR_API_KEY=

# ============================================
# Optional: PraisonAI Configuration
# ============================================
# If using PraisonAI agents instead of external CLIs
# OPENAI_API_KEY is also used by PraisonAI for GPT models
